# Local-only values (no real secrets): the Mongo app user exists only in this container; AWS keys are dummies
# because LDcommon.tabix() always asks boto3 for credentials (VCFs are local, so they are never used).
ENV=local
LOG_LEVEL=INFO
NUM_SUBPROCESSES=4
BASE_URL=http://localhost:8090
AWS_ACCESS_KEY_ID=<aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<aws_secret_access_key>
AWS_DEFAULT_REGION=us-east-1
DBSNP_VERSION=155
S3_BUCKET=local
S3_BUCKET_DATA_DIR=ldlink
DATA_DIR=/data/
TMP_DIR=/data/tmp/
LDASSOC_EXAMPLE_DIR=ldassoc_example/
POPULATION_SAMPLES_DIR=1000G_population_samples/
GENOTYPES_DIR=1000G/
LDTRAIT_SRC=https://www.ebi.ac.uk/gwas/api/search/downloads/alternative
MONGODB_HOST=mongo
MONGODB_PORT=27017
MONGODB_DATABASE=LDLink
MONGODB_USERNAME=<mongodb_username>
MONGODB_PASSWORD=<mongodb_password>
REQUIRE_TOKEN=<require_token>
TOKEN_EXPIRATION=<token_expiration>
TOKEN_EXPIRATION_DAYS=<token_expiration_days>
RESTRICT_CONCURRENCY=NO
LDLINK_INTERNAL_AUTH_TOKEN=<ldlink_internal_auth_token>
EMAIL_SMTP_HOST=localhost
EMAIL_ADMIN=admin@localhost
EMAIL_SUPERUSER=admin@localhost
